# Proveedor de IA para el chat: "openai" (por defecto) o "anthropic".
AI_PROVIDER=openai
OPENAI_API_KEY=
# Indica un modelo disponible en tu proyecto compatible con Structured Outputs.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Indica un modelo de Claude disponible en tu cuenta (p. ej. claude-opus-5).
ANTHROPIC_MODEL=
PORT=3001
# Persistencia de la API mediante el SDK. Clave secreta solo en el servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=


